const fs = require('fs');

function readTheFile(){
    const PromVal = new Promise(function(resolve){
    fs.readFile("Hello.txt","utf-8",function(err,data){
      resolve(data);
    })
  })
  return PromVal;
}

async function main(){
  let str = await readTheFile();
  let newStr = str.trim().replace(/\s+/g," ");
  fs.writeFile("Hello.txt",newStr,function(err){
    if(err) console.log("error");
    else{
      console.log("Printed successfully");
    }
  })
}

main();
